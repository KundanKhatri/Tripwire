# Copy to .env.local for local dev. NEVER commit .env.local.
# In Azure Container Apps, these come from Key Vault via managed identity.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_GPT41=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-large

# Azure AI Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-cs.cognitiveservices.azure.com/

# Cosmos for Postgres
POSTGRES_URL=postgresql://user:pass@host:5432/tripwire?sslmode=require

# Capability provenance signing key (rotate via Key Vault)
CAPABILITY_HMAC_SECRET=replace-me-32-byte-random

# App settings
LOG_LEVEL=INFO
ENVIRONMENT=local
APP_INSIGHTS_CONNECTION_STRING=
